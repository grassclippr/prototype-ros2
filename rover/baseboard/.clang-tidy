# clang-tidy config for ESP32-S3 firmware
# Run: pio check --environment LynxAdapter_v1_0
# Or standalone: clang-tidy src/**/*.cpp -- -I include -I .pio/libdeps/...

Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  misc-redundant-expression,
  misc-unused-using-decls,
  modernize-use-nullptr,
  modernize-use-auto,
  modernize-use-override,
  performance-*,
  readability-braces-around-statements,
  readability-inconsistent-declaration-parameter-name,
  readability-misleading-indentation,
  readability-magic-numbers,

# Treat these as errors (not just warnings):
WarningsAsErrors: >
  bugprone-use-after-move,
  bugprone-unused-return-value,
  bugprone-branch-clone,
  clang-analyzer-core.NullDereference,
  clang-analyzer-deadcode.DeadStores,

CheckOptions:
  - key:    readability-magic-numbers.IgnoredIntegerValues
    value:  '0;1;2;-1;10;100;1000'
  - key:    readability-magic-numbers.IgnoredFloatingPointValues
    value:  '0.0;1.0;0.5'
